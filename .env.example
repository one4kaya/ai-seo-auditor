# Выберите одного из бесплатных провайдеров LLM (достаточно указать один ключ)

# Вариант 1: OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Вариант 2: NVIDIA NIM (https://build.nvidia.com)
NVIDIA_API_KEY=

# Вариант 3: Google AI Studio / Gemini (https://aistudio.google.com)
GEMINI_API_KEY=
